# Copy this file to .env and fill in values for your environment.
# Never commit .env to version control.

# Generate a strong key with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here

DEBUG=False

# Comma-separated list of allowed hostnames
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# PostgreSQL: postgres://USER:PASSWORD@HOST:PORT/DBNAME
# SQLite (dev only): sqlite:///db.sqlite3
DATABASE_URL=postgres://helpdesk:password@localhost:5432/helpdesk

# Email (leave EMAIL_BACKEND as console for local dev)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=helpdesk@example.com
EMAIL_HOST_PASSWORD=your-smtp-password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=HelpDesk Pro <helpdesk@example.com>

# Public site URL used in email links
SITE_URL=https://yourdomain.com

# Email address to receive SLA breach escalation alerts (leave empty to disable)
SLA_ESCALATION_EMAIL=escalations@example.com

# Sentry DSN for error tracking (leave empty to disable)
SENTRY_DSN=
